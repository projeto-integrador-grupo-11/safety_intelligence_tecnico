AMBIENTE_PROCESSO=desenvolvimento

# Configurações de conexão com o banco de dados
DB_HOST= 127.0.0.1
DB_DATABASE='safety_intelligence'
DB_USER='root'
DB_PASSWORD='1234567'
DB_PORT=3306

# Configurações do servidor de aplicação
APP_PORT=3333
APP_HOST=localhost

# Configurações do JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=2h

# Planilha IDHM no S3 (mesmo bucket do JAR safety_leitor_excel)
S3_BUCKET=17042026-safety
S3_IDHM_KEY=idhm_municipios.xlsx
S3_POPULACAO_KEY=populacao_municipios_2025.xls
S3_SEGURANCA_KEY=banco_seguranca_2025.xlsx
POP_COL_NOME=3
POP_COL_POPULACAO=4
POP_COL_UF=0
AWS_REGION=us-east-1

# Serviço Java de e-mail e notificações Slack (safety_email_service)
# As mesmas vars atendem POST /emails/recuperacao-senha e POST /slack/notificar.
EMAIL_SERVICE_URL=http://localhost:8081
EMAIL_SERVICE_API_KEY=troque-esta-chave
# Página do front-end onde o usuário define a nova senha (o token é anexado como ?token=...)
RESET_URL_BASE=http://localhost:3333/redefinir-senha
